#: __init__.py:23
msgid "NVDA Remote"
msgstr "NVDA Remoto"

#: __init__.py:35
msgid "Mute or unmute the speech coming from the remote computer"
msgstr "Desativar ou ativar o som da fala vinda do computador remoto"

#: __init__.py:42
msgid "Sends the contents of the clipboard to the remote machine"
msgstr "Envia o conteúdo da área de transferência para a máquina remota"

#: __init__.py:47
msgid "Copies a link to the remote session to the clipboard"
msgstr "Copia um link para a sessão remota na área de transferência"

#: __init__.py:50
msgid "Copied link"
msgstr "Link copiado"

#: __init__.py:53
msgid "Disconnect a remote session"
msgstr "Desconectar uma sessão de acesso remoto"

#: __init__.py:57 client.py:177
msgid "Not connected."
msgstr "Não conectado."

#: __init__.py:62
msgid "Connect to a remote computer"
msgstr "Conectar a um computador remoto"

#: __init__.py:71
msgid "Toggles the control between guest and host machine"
msgstr "Alterna o controle entre a máquina convidada e a máquina anfitriã"

#: client.py:104
msgid "Your NVDA Remote configuration was corrupted and has been reset."
msgstr "Sua configuração do NVDA Remoto estava corrompida e foi redefinida."

#: client.py:105
msgid "NVDA Remote Configuration Error"
msgstr "Erro de Configuração do NVDA Remoto"

#: client.py:168 menu.py:52
msgid "Mute speech and sounds from the remote computer"
msgstr "Silencia fala e sons do computador remoto"

#: client.py:170
msgid "Unmute speech and sounds from the remote computer"
msgstr "Ativar áudio da fala e sons do computador remoto"

#: client.py:182
msgid "Clipboard pushed"
msgstr "Conteúdo da área de transferência enviado"

#: client.py:236
msgid "Error Connecting"
msgstr "Erro ao conectar"

#: client.py:238
msgid "Unable to connect to the remote computer"
msgstr "Não foi possível conectar ao computador remoto"

#: client.py:251 dialogs.py:251
msgid "Connect"
msgstr "Conectar"

#: client.py:292
msgid "Connected!"
msgstr "Conectado!"

#: client.py:315
msgid "Connection interrupted"
msgstr "Conexão interrompida"

#: client.py:340
msgid "Connected to control server"
msgstr "Conectado ao servidor de controle"

#: client.py:451
msgid "Controlling remote machine."
msgstr "Controlando a máquina remota."

#: client.py:455
msgid "Controlling local machine."
msgstr "Controlando a máquina local."

#: client.py:478
msgid ""
"NVDA Remote is already connected. Disconnect before opening a new connection."
msgstr ""
"O NVDA Remoto já está conectado. Desconecte antes de abrir uma nova conexão."

#: client.py:480
msgid "NVDA Remote Already Connected"
msgstr "O NVDA remoto já está conectado"

#: client.py:489
#, python-brace-format
msgid "Do you wish to control the machine on server {server} with key {key}?"
msgstr "Deseja controlar a máquina no servidor {server} com o código {key}?"

#: client.py:493
#, python-brace-format
msgid ""
"Do you wish to allow this machine to be controlled on server {server} with "
"key {key}?"
msgstr ""
"Deseja permitir que esta máquina seja controlada no servidor {server} com o "
"código {key}?"

#: client.py:498
msgid "NVDA Remote Connection Request"
msgstr "Solicitação de Conexão do NVDA Remoto"

#: dialogs.py:37
msgid "&Host:"
msgstr "&Servidor:"

#: dialogs.py:41 dialogs.py:114
msgid "&Key:"
msgstr "&Código:"

#: dialogs.py:45 dialogs.py:117
msgid "&Generate Key"
msgstr "&Gerar Código"

#: dialogs.py:52
msgid "Host must be set."
msgstr "O servidor deve ser definido."

#: dialogs.py:52 dialogs.py:164 dialogs.py:210 dialogs.py:213
msgid "Error"
msgstr "Erro"

#: dialogs.py:103
msgid "Get External &IP"
msgstr "Obter o Endereço &IP Externo"

#: dialogs.py:107
msgid "&External IP:"
msgstr "IP &externo:"

#: dialogs.py:111
msgid "&Port:"
msgstr "&Porta:"

#: dialogs.py:156
#, python-brace-format
msgid "Successfully retrieved IP address. Port {port} is open."
msgstr "Endereço IP capturado com sucesso. A porta {port} está aberta."

#: dialogs.py:156
msgid "Success"
msgstr "Sucesso"

#: dialogs.py:158
#, python-brace-format
msgid "Retrieved external IP, but port {port} is not currently forwarded."
msgstr "IP externo capturado, mas a porta {port} não permite passagem."

#: dialogs.py:158
msgid "Warning"
msgstr "Atenção"

#: dialogs.py:164
msgid ""
"Unable to contact portcheck server, please manually retrieve your IP address"
msgstr ""
"Impossível contatar o servidor portcheck — verificação de porta —, capture "
"manualmente seu endereço IP"

#: dialogs.py:176
msgid "Client"
msgstr "Cliente"

#: dialogs.py:176
msgid "Server"
msgstr "Servidor"

#: dialogs.py:180
msgid "Control another machine"
msgstr "Controlar outra máquina"

#: dialogs.py:180
msgid "Allow this machine to be controlled"
msgstr "Permitir que essa máquina seja controlada"

#: dialogs.py:210
msgid "Both host and key must be set."
msgstr "O servidor e o código devem estar configurados."

#: dialogs.py:213
msgid "Both port and key must be set."
msgstr "A porta e o código devem estar configurados."

#: dialogs.py:247
msgid "NVDA Remote Connection Security Warning"
msgstr "Advertência de Segurança de Conexão do NVDA Remoto"

#: dialogs.py:249
#, python-brace-format
msgid ""
"Warning! The certificate of this server could not be verified.\n"
"This connection may not be secure. It is possible that someone is trying to "
"overhear your communication.\n"
"Before continuing please make sure that the following server certificate "
"fingerprint is a proper one.\n"
"If you have any questions, please contact the server administrator.\n"
"\n"
"Server SHA256 fingerprint: {fingerprint}\n"
"\n"
"Do you want to continue connecting?"
msgstr ""
"Aviso! O certificado deste servidor não pôde ser verificado.\n"
"Esta conexão pode não ser segura. É possível que alguém esteja tentando "
"ouvir sua comunicação.\n"
"Antes de continuar, por favor certifique-se de que a seguinte impressão "
"digital de certificado do servidor é adequada.\n"
"Se você tiver alguma dúvida, por favor entre em contato com o administrador "
"do servidor.\n"
"\n"
"Impressão digital SHA256 do servidor: {fingerprint}\n"
"\n"
"Você quer continuar se conectando?"

#: dialogs.py:251
msgid "Connect and do not ask again for this server"
msgstr "Conecte-se e não pergunte novamente para este servidor"

#: localMachine.py:316
msgid "No permission on device to trigger CTRL+ALT+DEL from remote"
msgstr ""
"Nenhuma permissão no dispositivo para acionar Ctrl+alt+del desde remoto"

#: menu.py:32
msgid "Connect..."
msgstr "Conectar..."

#: menu.py:33
msgid "Remotely connect to another computer running NVDA Remote Access"
msgstr ""
"Conecta remotamente a outro computador executando o Acesso Remoto do NVDA"

#: menu.py:41
msgid "Disconnect"
msgstr "Desconectar"

#: menu.py:42
msgid "Disconnect from another computer running NVDA Remote Access"
msgstr ""
"Desconecta de outro computador que esteja executando o Acesso Remoto do NVDA"

#: menu.py:51
msgid "Mute remote"
msgstr "Silenciar computador remoto"

#: menu.py:60
msgid "&Push clipboard"
msgstr "Emviar &texto da área de transferência"

#: menu.py:61
msgid "Push the clipboard to the other machine"
msgstr "Envia a área de transferência para a outra máquina"

#: menu.py:69
msgid "Copy &link"
msgstr "Copiar &link"

#: menu.py:69
msgid "Copy a link to the remote session"
msgstr "Copiar um link para a sessão remota"

#: menu.py:77
msgid "Send Ctrl+Alt+Del"
msgstr "Enviar Control+Alt+Del"

#: menu.py:85
msgid "R&emote"
msgstr "R&emoto"

#: menu.py:85
msgid "NVDA Remote Access"
msgstr "Acesso Remoto do NVDA"

#. translators: Message for version mismatch
#: session.py:171
msgid ""
"The version of the relay server which you have connected to is not "
"compatible with this version of the Remote Client.\n"
"Please either use a different server or upgrade your version of the addon."
msgstr ""
"A versão do servidor de retransmissão à qual você se conectou não é "
"compatível com esta versão do cliente remoto.\n"
"Por favor, use um servidor diferente ou atualize sua versão do complemento."

#: session.py:197
msgid "Message of the Day"
msgstr "Mensagem do Dia"

#: session.py:512
msgid "Remote NVDA not connected."
msgstr "NVDA remoto não conectado."

#: settings_panel.py:8
msgid "Remote"
msgstr "Remoto"

#: settings_panel.py:21
msgid "Auto-connect to control server on startup"
msgstr "Conectar automaticamente com o servidor de controle ao iniciar"

#: settings_panel.py:25
msgid "Use Remote Control Server"
msgstr "Usar servidor de controle remoto"

#: settings_panel.py:25
msgid "Host Control Server"
msgstr "Servidor de Controle Hospedeiro local"

#: settings_panel.py:48
msgid "Play sounds instead of beeps"
msgstr "Reproduzir sons em vez de bipes"

#: settings_panel.py:51
msgid "Delete all trusted fingerprints"
msgstr "Excluir todas as impressões digitais confiáveis"

#: settings_panel.py:85
msgid ""
"When connecting to an unauthorized server, you will again be prompted to "
"accepts its certificate."
msgstr ""
"Ao se conectar a um servidor não autorizado, você será motivado novamente a "
"aceitar seu certificado."

#: settings_panel.py:85
msgid "Are you sure you want to delete all stored trusted fingerprints?"
msgstr ""
"Tem certeza de que deseja excluir todas as impressões digitais confiáveis "
"armazenadas?"

#: settings_panel.py:93
msgid "Both host and key must be set in the Remote section."
msgstr "O servidor e o código devem ser definidos na seção Remoto."

#: settings_panel.py:93 settings_panel.py:96
msgid "Remote Error"
msgstr "Erro Remoto"

#: settings_panel.py:96
msgid "Both port and key must be set in the Remote section."
msgstr "A porta e o código devem ser definidos na seção Remoto."

